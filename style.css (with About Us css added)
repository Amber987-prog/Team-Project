}

#indexSec3Border {
  background: var(--white-semi);
  width: 100%;

  font-family: Arial, sans-serif;
  padding: 3.5rem 5% 4.5rem;
  box-sizing: border-box;
}

#indexSec3 {
  max-width: 1400px;
  margin: 0 auto;
}

#indexSec3TitleBorder {
  background: var(--green);

  color: white;
  padding: 1.2rem 2rem;
  border-radius: 12px;
  text-align: center;
  margin-bottom: 1.8rem;
  box-shadow: 0 4px 12px rgba(108, 130, 108, 0.25);
}

#indexSec3Title h4 {
  margin: 0;
