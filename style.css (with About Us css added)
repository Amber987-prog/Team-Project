.reviewface img {
  width: clamp(90px, 18vw, 110px);
  height: clamp(90px, 18vw, 110px);
  object-fit: cover;
  border-radius: 50%;
  border: 3px solid var(--green);
  box-shadow: 0 3px 12px rgba(0, 102, 0, 0.2);
