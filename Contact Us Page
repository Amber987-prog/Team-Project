/* Contact Page CSS */

body {
  margin: 0;
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
  background: #f6f7fb;
  color: #111;
  line-height: 1.5;
}



.contact-hero,
.contact-info,
.contact-form-section {
  max-width: 1100px;
  margin: 0 auto;
  padding: 24px 16px;
}


.contact-hero {
  text-align: center;
  padding-top: 60px;
  padding-bottom: 24px;
}

.contact-hero h1 {
  margin: 0 0 14px;
  font-size: clamp(30px, 3vw, 44px);
  letter-spacing: -0.5px;
}

.contact-hero p {
  margin: 0 auto;
  max-width: 720px;
  font-size: 16px;
  opacity: 0.85;
}



.contact-info {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32px;
  padding-top: 10px;
}



.contact-box,
.contact-form {
  background: #ffffff;
  border-radius: 16px;
  padding: 22px;
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06);
  border: 1px solid rgba(0, 0, 0, 0.08);
}

.contact-box h2 {
  margin: 0 0 16px;
  font-size: 20px;
  letter-spacing: -0.3px;
}

.contact-box {
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.contact-box:hover {
  transform: translateY(-4px);
  box-shadow: 0 18px 35px rgba(0,0,0,0.08);
}

.contact-form button {
  letter-spacing: 0.3px;
}




.map-box {
  height: 260px;
  border-radius: 14px;
  border: 1px dashed rgba(0, 0, 0, 0.25);
  background: #f2f4f8;
  display: grid;
  place-items: center;
  margin-bottom: 14px;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.7);
}


.map-embed {
  width: 100%;
  height: 260px;
  border: 0;
  border-radius: 14px;
}



.note {
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px solid rgba(0, 0, 0, 0.15);
  font-size: 14px;
  opacity: 0.8;
}



.contact-form-section {
  text-align: center;
  padding-top: 40px;
  padding-bottom: 60px;
}

.contact-form-section h2 {
  margin: 0 0 20px;
  font-size: 28px;
  letter-spacing: -0.3px;
}



.contact-form {
  max-width: 820px;
  margin: 0 auto;
  text-align: left;

  display: grid;
  gap: 14px;
}

.contact-form label {
  font-weight: 600;
  font-size: 14px;
}

.contact-form input,
.contact-form textarea {
  width: 100%;
  padding: 12px 14px;
  border-radius: 12px;
  border: 1px solid rgba(0, 0, 0, 0.18);
  font-size: 15px;
  outline: none;
  transition: all 0.2s ease;
}

.contact-form input:focus,
.contact-form textarea:focus {
  border-color: rgba(0, 0, 0, 0.45);
  box-shadow: 0 0 0 4px rgba(0, 0, 0, 0.08);
}

.contact-form-section h2 {
  font-weight: 700;
}




.contact-form button {
  margin-top: 10px;
  padding: 12px 18px;
  border-radius: 14px;
  border: none;
  background: #111;
  color: #fff;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
  transition: transform 0.08s ease, filter 0.2s ease;
}

.contact-form button:hover {
  filter: brightness(1.08);
}

.contact-form button:active {
  transform: translateY(1px);
}


@media (max-width: 800px) {
  .contact-info {
    grid-template-columns: 1fr;
  }

  .map-box,
  .map-embed {
    height: 320px;
  }
}
