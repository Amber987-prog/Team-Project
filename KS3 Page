CSS 

.ks3-page {
  max-width: 1100px;
  margin: 0 auto;
  padding: 40px 16px 60px;
}


.ks3-hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: center;
}

.ks3-hero__text h1 {
  font-size: clamp(32px, 4vw, 44px);
  margin-bottom: 12px;
}

.ks3-hero__text p {
  opacity: 0.85;
  margin-bottom: 16px;
}


.carousel-box {
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 12px 28px rgba(0,0,0,0.08);
}

.carousel-box img {
  height: 350px;
  object-fit: cover;
}


.ks3-topics {
  margin-top: 60px;
  text-align: center;
}

.topic-grid {
  margin-top: 30px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30px;
}

.topic-card {
  background: #ffffff;
  border-radius: 16px;
  padding: 20px;
  text-decoration: none;
  color: #111;
  box-shadow: 0 12px 28px rgba(0,0,0,0.06);
  transition: transform 0.2s ease;
}

.topic-card:hover {
  transform: translateY(-6px);
}

.topic-img {
  height: 180px;
  overflow: hidden;
  border-radius: 12px;
  margin-bottom: 12px;
}

.topic-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}


.ks3-cta {
  margin-top: 80px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: center;
}

.ks3-cta__img {
  height: 300px;
  overflow: hidden;
  border-radius: 16px;
}

.ks3-cta__img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}


@media (max-width: 900px) {
  .ks3-hero,
  .ks3-cta,
  .topic-grid {
    grid-template-columns: 1fr;
  }

  .carousel-box img {
    height: 250px;
  }
}
