<style>
body {
  margin: 0;
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
  background: #f6f7fb;
  color: #111;
  line-height: 1.5;
}

.About-Us,
.Meet-Us {
  max-width: 1100px;
  margin: 0 auto;
  padding: 24px 16px;
}

.About-Us, .Meet-Us {
  text-align: center;
  padding-top: 60px;
  padding-bottom: 24px;
}

.About-Us h1 {
  margin: 0 0 14px;
  font-size: clamp(30px, 3vw, 44px);
  letter-spacing: -0.5px;
}

.About-Us p {
  margin: 0 auto;
  max-width: 720px;
  font-size: 16px;
  opacity: 0.85;
}
.team-member-1, .team-member-2, .team-member-3, .team-member-4 {

  height: 450px;
  border-radius: 16px;
  border: 1px dashed rgba(0, 0, 0, 0.25);
  background: #3f898a;
  display: grid;
  place-items: center;
  margin-bottom: 16px;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.7);
}

footer {
    display: grid;
    grid-template-columns: 20% 20% 20% 20% 20%;
    background-color: #3f898a;
    color: white;
    align-content: center;
    font-family: "DM Sans", serif;
    padding: 20px;
    border-width: 1px;
    border-top-style: solid;
    font-family: Arial, Helvetica, sans-serif;
}
footer a{
    color: white;
}
* {
  margin: 0;
  padding: 0;
  font-family: Arial, sans-serif;
  font-weight: bold;
  font-size: 20px;
}

.navbar {
  background: #4ea5a7;
  padding: 20px 30px;
  text-align: center;
}

.menu {
  list-style: none;
  display: flex;
  justify-content: center;
  gap: 25px;
}

.item {
  position: relative;
}

.menu a {
  text-decoration: none;
  color: #ffffff;
  padding: 8px 14px;
  border-radius: 20px;
  display: inline-block;
}

.menu a:hover {
  background: #357475;
}

.dropdown {
  display: none;          
  position: absolute;
  background: #4ea5a7;
  list-style: none;
  padding: 8px;
  border-radius: 12px;
  min-width: 120px;
}

.item:hover > .dropdown,
.dropdown li:hover > .dropdown {
  display: block;
}

.dropdown li {
  position: relative;
}
.dropdown .dropdown {
  top: 0px;;
  left: 100%;
}

